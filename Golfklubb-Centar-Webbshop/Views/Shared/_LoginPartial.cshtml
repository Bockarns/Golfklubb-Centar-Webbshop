@using Microsoft.AspNetCore.Identity
@using System.Text.Json
@using Golfklubb_Centar_Webbshop.Areas.Identity.Data
@using Golfklubb_Centar_Webbshop.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var cartJson = Context.Session.GetString("GolfklubbCart") ?? "[]";
    var cartCount = JsonSerializer.Deserialize<List<CartItem>>(cartJson)?.Sum(c => c.Quantity) ?? 0;
}

<ul class="navbar-nav">
    <li class="nav-item">
        <a asp-controller="Cart" asp-action="Index" class="nav-link position-relative">
            <i class="bi bi-cart3 fs-5"></i>
            @if (cartCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @cartCount
                </span>
            }
        </a>
    </li>

    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin Panel</a>
            </li>
        }
        <li class="nav-item">
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">Hej @UserManager.GetUserName(User)!</a>
        </li>
        <li class="nav-item">
            <a asp-controller="Notification" asp-action="NotificationsList" class="nav-link position-relative">
                <i class="bi bi-bell fs-5"></i>
                @* <span id="notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span> *@
                @* Badge med antal olästa *@
                <span id="notification-badge"
                      class="position-absolute top-0 start-100 translate-middle
                    badge rounded-pill bg-danger"
                      style="font-size: 10px; display: none;">
                    0
                </span>
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logga ut</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Registrera</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Logga in</a>
        </li>
    }
</ul>