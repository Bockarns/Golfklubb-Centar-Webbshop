@model Golfklubb_Centar_Webbshop.Models.UserProfileViewModel

@{
    ViewData["Title"] = $"{Model.UserName} | Profil";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* Profilkort *@
            <div class="card box-white mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-4 mb-3">
                        <img src="@(Model.ProfileImageUrl ?? "/images/Profile/avatar.png")"
                             class="rounded-circle border"
                             style="width: 90px; height: 90px; object-fit: cover;" />
                        <div>
                            <h4 class="mb-0">@Model.UserName</h4>
                            @if (!string.IsNullOrEmpty(Model.UserName))
                            {
                                <p class="text-muted mb-1">@Model.UserName</p>
                            }
                        </div>
                    </div>

                    @* Statistik *@
                    <div class="d-flex gap-4 mb-3">
                        <div class="text-center">
                            <p class="fw-500 mb-0">@Model.Posts.Count</p>
                            <small class="text-muted">Inlägg</small>
                        </div>
                        <div class="text-center">
                            <p class="fw-500 mb-0">@Model.CommentCount</p>
                            <small class="text-muted">Kommentarer</small>
                        </div>
                        <div class="text-center">
                            <a asp-controller="Follow" asp-action="Followers"
                                   asp-route-id="@Model.UserId"
                                   class="text-decoration-none text-dark">
                                <p class="fw-500 mb-0">@Model.FollowersCount</p>
                                <small class="text-muted">Följare</small>
                            </a>
                        </div>
                        <div class="text-center">
                            <a asp-controller="Follow" asp-action="Following"
                                   asp-route-id="@Model.UserId"
                                   class="text-decoration-none text-dark">
                                <p class="fw-500 mb-0">@Model.FollowingCount</p>
                                <small class="text-muted">Följer</small>
                            </a>
                        </div>
                    </div>

                    @* Följ/avfölja knapp *@
                    @if (!Model.IsCurrentUser && User.Identity.IsAuthenticated)
                    {
                        <form method="post" asp-controller="Follow" asp-action="ToggleFollow"
                              asp-route-followedUserId="@Model.UserId">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn @(Model.IsFollowing ? "btn-outline-secondary" : "btn-primary") btn-sm">
                                @(Model.IsFollowing ? "Avfölja" : "Följ")
                            </button>
                        </form>
                    }
                    else if (Model.IsCurrentUser)
                    {
                        <a asp-page="/Account/Manage/UserDetails" class="btn btn-outline-secondary btn-sm">
                            Redigera profil
                        </a>
                    }
                </div>
            </div>

            @* Foruminlägg *@
            <div class="card box-white">
                <div class="card-header">
                    <h5 class="mb-0">Foruminlägg (@Model.Posts.Count)</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Posts.Any())
                    {
                        <p class="text-muted">Inga foruminlägg än.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var post in Model.Posts)
                            {
                                <a asp-controller="Forum" asp-action="Detail"
                                       asp-route-id="@post.PostId"
                                       class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between">
                                        <p class="mb-0">@post.PostTitle</p>
                                        <small class="text-muted">
                                            @post.PostCreateDate.ToString("yyyy-MM-dd")
                                        </small>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Kommentarer *@
            <div class="card box-white">
                <div class="card-header">
                    <h5 class="mb-0">Kommentarer (@Model.Comments.Count)</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Comments.Any())
                    {
                        <p class="text-muted">Inga kommentarer än.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var comment in Model.Comments)
                            {
                                <a asp-controller="Forum" asp-action="Detail"
                                       asp-route-id="@comment.CommentId"
                                       class="list-group-item list-group-item-action">
                                    <div class="d-flex justify-content-between">
                                        <p class="mb-0">@comment.CommentContent</p>
                                        <small class="text-muted">
                                            @comment.CommentDateTime.ToString("yyyy-MM-dd")
                                        </small>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>