@model Golfklubb_Centar_Webbshop.Models.Post

@{
    ViewData["Title"] = "New thread";
 }

<div class="container py-4 box-white">
    <h2 class="mb-4">Starta en ny tråd</h2>
 <hr />

    <div class="container text-center box-white col-4">
    <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-bg-success"></div>
	


    <div class="mb-3">
        <label asp-for="PostTitle" class="form-label">Titel</label>
        <input asp-for="PostTitle" class="form-control" placeholder="Trådtitel"/>
        <span asp-validation-for="PostTitle" class="text-bg-success"></span>
	</div>

     <div class="mb-3 py-4">
        <label asp-for="PostContent" class="form-label">Meddelande</label>
		<textarea asp-for="PostContent" class="form-control" rows="6" placeholder="Skriv ditt meddelande här.."></textarea>
        <span asp-validation-for="PostContent" class="text-success"></span>
	</div>

       <div class="d-flex gap-2">
         <input type="submit" class="btn btn-success" value="Skapa tråd"/>
         <a asp-action="Index" class="btn btn-outline-success">Avbryt</a>
       </div>

    </form>
		
   </div>    
</div>

