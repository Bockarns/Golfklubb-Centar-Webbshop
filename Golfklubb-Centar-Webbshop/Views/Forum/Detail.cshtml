@model Golfklubb_Centar_Webbshop.Models.PostDetailVM
@using Golfklubb_Centar_Webbshop.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Post.PostTitle;
    ViewData["PageClass"] = "page-forum";
}

@section Styles {
    <link href="~/css/forum.css" rel="stylesheet" asp-append-version="true" />
}

<div class="banner text-center">
    <div class="banner-text">
        <h1 class="display-4">Forum</h1>
    </div>
</div>

<div class="container py-4 box-white mt-4">  
<a asp-controller="Forum" asp-action="Index" class="btn btn-success">&larr;  Tillbaka till tråd</a>
   
    @if (User.Identity.IsAuthenticated && (@Model.Post.FkUser.Id == UserManager.GetUserId(User)
                                    || User.IsInRole("Admin")))
    {
        <form asp-controller="Forum" asp-action="PostDelete" method="post" class="nav-link text-dark">
            <input type="hidden" name="id" value="@Model.Post.PostId" />@Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger mt-2" onclick="return confirm('Vill du verkligen radera ditt svar?')">Radera tråd</button>
        </form>             
    }
    
</div>
  
<div class="card mb-4">
    
    <div class="card-header d-flex justify-content-between align-items-center">
        <a asp-controller="User" asp-action="Profile" asp-route-id="@Model.Post.FkUser.Id"
               class="d-flex align-items-center gap-2 text-decoration-none text-dark user-link">
            @if (!string.IsNullOrEmpty(Model.Post.FkUser.ProfileImageUrl))
            {
                <img src="@Model.Post.FkUser.ProfileImageUrl"
                        alt="profile-image"
                        class="rounded-circle"
                        style="width:36px; height:36px; object-fit:cover;">
            }
            else
            {
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center"
                        style="width:36px; height:36px; font-size:0.85rem;">
                    @Model.Post.FkUser.UserName?.Substring(0, 1).ToUpper()
                </div>
            }
            <span class="fw-semibold small">@Model.Post.FkUser.UserName</span>
            </a>
        <small class="text-muted">@Model.Post.PostCreateDate.ToLocalTime().ToString("g")</small>
        
    </div>    
    <div class="card-body">
        <h4 class="card-title">@Model.Post.PostTitle</h4>
        <p class="card-text" style="white-space: pre-wrap">@Model.Post.PostContent</p>
    </div>
</div>

@if (Model.CommentPagination.Comments.Any())
    {
    <h5>@Model.CommentPagination.Comments.Count @(Model.CommentPagination.Comments.Count == 1 ? "Svar" : "Svar")</h5>
    <hr />
  

    @foreach(var comment in Model.CommentPagination.Comments)
    {
        <div class="container py-4 box-white">
            @if (User.Identity.IsAuthenticated && (comment.FkUser.Id == UserManager.GetUserId(User)
                                || User.IsInRole("Admin")))
            {
                <form asp-controller="Forum" asp-action="DeleteComment" method="post" class="nav-link text-dark">
                    <input type="hidden" name="id" value="@comment.CommentId" />@Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger mt-2" onclick="return confirm('Vill du verkligen radera ditt svar?')">
                        Radera svar
                    </button>
                </form>
            }
        </div>

        <div class="card mb-2">
            <div class="card-header d-flex justify-content-between align-items-center">
                <a asp-controller="User" asp-action="Profile" asp-route-id="@comment.FkUserId"
                       class="d-flex align-items-center gap-2 text-decoration-none text-dark user-link">
                    @if (!string.IsNullOrEmpty(comment.FkUser.ProfileImageUrl))
                    {
                        <img src="@comment.FkUser.ProfileImageUrl"
                                alt="profile-image"
                                class="rounded-circle"
                                style="width:36px; height:36px; object-fit:cover;">
                    }
                    else
                    {
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center"
                                style="width:36px; height:36px; font-size:0.85rem;">
                            @comment.FkUser.UserName?.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <span class="fw-semibold small">@comment.FkUser.UserName</span>
                    
                </a>
                <small class="text-muted">@comment.CommentDateTime.ToLocalTime().ToString("g")</small>
            </div>
            <div class="card-body">
                <p class="card-text mb-0" style="white-space: pre-wrap">@comment.CommentContent</p>
           </div>
       </div>
    }

}
else
{
    <p class="text-muted">Inga svar ännu. Bli den första som svarar!</p>
}
<!-- PAGINATION -->
@if (Model.CommentPagination.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">

            <li class="page-item @(Model.CommentPagination.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Detail"
                       asp-route-id="@Model.Post.PostId"
                       asp-route-page="@(Model.CommentPagination.CurrentPage - 1)">
                    Föregående
                </a>
            </li>

            @for (int i = 1; i <= Model.CommentPagination.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CommentPagination.CurrentPage ? "active" : "")">
                    <a class="page-link"
                           asp-action="Detail"
                           asp-route-id="@Model.Post.PostId"
                           asp-route-page="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CommentPagination.CurrentPage == Model.CommentPagination.TotalPages ? "disabled" : "")">
                <a class="page-link"
                       asp-action="Detail"
                       asp-route-id="@Model.Post.PostId"
                       asp-route-page="@(Model.CommentPagination.CurrentPage + 1)">
                    Nästa
                </a>
            </li>

        </ul>
    </nav>
}
<hr/>
<h5>Skicka ett svar!</h5>
@if (User.Identity!.IsAuthenticated)
{
    <form asp-action="Reply" asp-controller="Forum" method="post">
        <input type="hidden" name="postId" value="@Model.Post.PostId" />
        <textarea name="content" class="form-control mb-2"
                  rows="4" placeholder="Skriv ditt svar.." required></textarea>
        <input type="submit" value="Skicka svar" class="btn btn-success" />
    </form>
}
else
{
    <a asp-area="Identity"
           asp-page="/Account/Login"
           asp-route-returnUrl="@Url.Action("Detail", "Forum", new { id = Model.Post.PostId })"
           class="btn btn-success">
        Logga in för att svara
    </a>
}

