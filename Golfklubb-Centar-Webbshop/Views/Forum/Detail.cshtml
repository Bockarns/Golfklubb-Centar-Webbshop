@model Golfklubb_Centar_Webbshop.Models.Post
@using Golfklubb_Centar_Webbshop.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.PostTitle;
    ViewData["PageClass"] = "page-contact";
}

<div class="banner text-center">
    <div class="banner-text">
        <h1 class="display-4">Forum</h1>
    </div>
</div>

<div class="container py-4 box-white mt-4">  
<a asp-controller="Forum" asp-action="Index" class="btn btn-success">&larr;  Tillbaka till tråd</a>
   
    @if (User.Identity.IsAuthenticated && (@Model.FkUser.Id == UserManager.GetUserId(User)
                                    || User.IsInRole("Admin")))
    {
        <form asp-controller="Forum" asp-action="PostDelete" method="post" class="nav-link text-dark">
            <input type="hidden" name="id" value="@Model.PostId" />@Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger mt-2" onclick="return confirm('Vill du verkligen radera ditt svar?')">Radera tråd</button>
        </form>             
    }
    
</div>
  
<div class="card mb-4">
    
    <div class="card-header d-flex justify-content-between align-items-center">
        <a asp-controller="User" asp-action="Profile" asp-route-id="@Model.FkUser.Id"><strong>@Model.FkUser</strong></a>
        <small class="text-muted">@Model.PostCreateDate.ToLocalTime().ToString("g")</small>
    </div>    
    <div class="card-body">
        <h4 class="card-title">@Model.PostTitle</h4>
        <p class="card-text" style="white-space: pre-wrap">@Model.PostContent</p>
    </div>
</div>

@if (Model.Comments.Any())
    {
    <h5>@Model.Comments.Count @(Model.Comments.Count == 1 ? "Reply" : "Replies")</h5>
    <hr />
  

    @foreach(var comment in Model.Comments)
    {
        <div class="container py-4 box-white">
            @if (User.Identity.IsAuthenticated && (comment.FkUser.Id == UserManager.GetUserId(User)
                                || User.IsInRole("Admin")))
            {
                <form asp-controller="Forum" asp-action="DeleteComment" method="post" class="nav-link text-dark">
                    <input type="hidden" name="id" value="@comment.CommentId" />@Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger mt-2" onclick="return confirm('Vill du verkligen radera ditt svar?')">
                        Radera svar
                    </button>
                </form>
            }
        </div>

        <div class="card mb-2">
    <div class="card-header d-flex justify-content-between align-items-center">
                <a asp-controller="User" asp-action="Profile" asp-route-id="@comment.FkUserId"><strong>@comment.FkUser.UserName</strong></a>
                <small class="text-muted">@comment.CommentDateTime.ToLocalTime().ToString("g")</small>
              
    
</div>
    <div class="card-body">
        <p class="card-text mb-0" style="white-space: pre-wrap">@comment.CommentContent</p>
           </div>
       </div>
    }
}
else
{
    <p class="text-muted">Inga svar ännu. Bli den första som svarar!</p>
}
<hr/>
<h5>Skicka ett svar!</h5>
<form asp-action="Reply" asp-controller="Forum" method="post">
    <input type="hidden" name="postId" value="@Model.PostId" />
    <div class="mb-3">
        @if (!User.Identity!.IsAuthenticated)
            {
                <input type="text" name="FkUser" class="form-control mb-2" placeholder="Ditt namn (valfritt)" maxlength="256"/>
            }
    <textarea name="content" class="form-control" rows="4" placeholder="Skriv ditt svar.." required></textarea>
        </div>
        <input type="submit" value="Skicka svar" class="btn btn-success"/>
</form>

