@model IEnumerable<Golfklubb_Centar_Webbshop.Models.Notification>

@{
    ViewData["Title"] = "Mina Notifikationer";
}

<div class="row text-center">
    <h2 class="box-white text-center">@ViewData["Title"]</h2>
</div>

<div class="container mt-4 box-white">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Notifikationer</h4>
                <span class="text-muted" style="font-size: 13px;">
                    @Model.Count(n => !n.IsRead) olästa
                </span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="card box-white text-center p-4">
                    <p class="text-muted mb-0">Inga notifikationer än.</p>
                </div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var notification in Model)
                    {
                        <div class="list-group-item list-group-item-action
                            @(!notification.IsRead ? "border-start border-primary border-3" : "")"
                             style="background: var(--bs-body-bg);">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-primary mb-1"
                                              style="font-size: 10px;">Ny</span>
                                    }
                                    <p class="mb-1">@notification.Message</p>
                                    <small class="text-muted">
                                        @notification.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    </small>
                                </div>
                                <form method="post" asp-action="Delete" asp-route-id="@notification.NotificationId"
                                      onsubmit="return confirm('Radera notifikationen?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        &times;
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>