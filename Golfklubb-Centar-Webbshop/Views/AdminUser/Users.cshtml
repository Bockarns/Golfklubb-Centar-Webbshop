@model List<Golfklubb_Centar_Webbshop.Areas.Identity.Data.ApplicationUser>

@{
    ViewData["Title"] = "Användare";
}
<div class="col-md-9 text-center">
    <h2>@ViewData["Title"]</h2>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-3">
            <partial name="_AdminNav" />
        </div>
        <div class="col-md-9 box-white border rounded">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Alla Användare</h4>
            </div>
            <table class="table table-hover box-white-table ">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Användarnamn</th>
                        <th>Info</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.UserName</td>
                            <td><a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info">Info</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>