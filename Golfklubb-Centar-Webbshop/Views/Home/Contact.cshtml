@{
    ViewData["Title"] = "Contact Page";
    ViewData["PageClass"] = "page-contact";
}
@section Styles {
    <link href="~/css/home.css" rel="stylesheet" asp-append-version="true" />
}
<div class="banner">
    <div class="banner-text">
        <h1>Kontakta oss</h1>
    </div>
</div>

<div class="container box-white text-center p-2">
<div class="container mt-2 mb-3">
    <div class="row">
        <div class="col-12 col-md-4">
            
                <h2>Frågor och svar!</h2>
                <div class="dropdown">
                    <button class="btn btn-success mb-2 rounded-0 w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Hur kontaktar jag banskötaren?
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item">Du kan kontakta Jerome Gordon-Bock på telefonnummer 017-033 57 03 mellan 08:00-17:00</a></li>
                    </ul>
                    <button class="btn btn-success mb-2 rounded-0 w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Hur bör jag hantera ett problem som uppstår i restaurangen?
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item">Vänligen kontakta vår restaurangchef Ninos Pito på telefonnummret 017-033 58 03 eller via mejl på ninosrestaurang@gkcentar.se</a></li>
                    </ul>
                    <button class="btn btn-success mb-2 rounded-0 w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Vad gör jag om jag har ett problem med en arbetare?
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item">Välkommen att kontakta personalchefen Peyman Khateri, på telefonnummret 017-333 69 03. HAn finns tillgänglig mellan 09:00-18:00</a></li>
                    </ul>
                    <button class="btn btn-success mb-2 rounded-0 w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Jag vill sponsra er, hur gör jag det?
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item">Om man önskar att sponsra oss, vänligen kontakta vår marketingteam via e-post marketing@gkcentar.se</a></li>
                    </ul>
                    <button class="btn btn-success mb-2 rounded-0 w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Finns det möjlighet att hyra utrustning?
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item">Ja självklart kan du hyra utrustning hos oss. Vänligen kontakta vår shop via e-post shop@gkcentar.se för mer information.</a></li>
                    </ul>
                    <button class="btn btn-success mb-2 rounded-0 w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Behöver man boka starttid i förväg?
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item">Ja, vi rekommenderar att du bokar starttid i förväg för att vara säker på att få en tid som passar dig. Det går enkelt att boka via vår hemsida eller genom att kontakta oss direkt. <br /> I mån av plats går det ibland även att spela utan bokning, men vi kan tyvärr inte garantera tillgänglighet då.</a></li>
                    </ul>
                    </div>
               </div>
            
        <div class="col-12 col-md-8 text-md-start">
                <h2>Hitta till oss!</h2>
                <div class="row">
                    <div class="col-12 col-md-8">              
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2125.4739373131753!2d14.287979076450228!3d57.78954747396332!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x465a73ad9e6765ab%3A0xa0b7c529b41c70a9!2sDatorgatan%206%2C%20561%2033%20Huskvarna!5e0!3m2!1ssv!2sse!4v1716050000000!5m2!1ssv!2sse"
                            class="w-100" height="300" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                                
                    <div class="col-md-4">
                        <h5>Adress</h5>
                        <p class="small">Datorgatan 6<br>561 33 Huskvarna</p>
                    
                        <h5>Telefon</h5>
                        <p class="small">0140-44 45 10</p>
                    
                        <h5>E-post</h5>
                        <p class="small">info@tucsweden.se</p>
                                        
                        <h5>Öppettider</h5>
                        <ul class="no-bullets">
                            <li class="small">Mån-Fre: 08:00-18:00</li>
                            <li class="small">Lör: 09:00-15:00</li>
                            <li class="small">Sön: Stängt</li>
                        </ul>
                    </div>
                </div>
             </div>          
        </div>
     </div>
</div>

<div class="container box-white text-center p-2 mt-4 w-75">
    <div class="container mt-2 mb-3">
        <div class="row">
            <div class="col-md-6 offset-md-3">
                
                      <h2>Kontakta oss vid frågor & feedback</h2>      
                    
           <form method="post">

                <div class="mb-3">
                    <label class="form-label">Namn</label>
                        <br/>
                            <input name="Name" class="form-control mb-2" placeholder="Namn" required>
                <div class="mb-3">
                    <label class="form-label">E-post</label>
                        <br/>
                            <input type="email" class="form-control" placeholder="email@example.com" required>   
             </div>
                <div class="mb-3">
                    <label class="form-label">Meddelande</label>
                        <textarea class="form-control w-100" rows="7" placeholder="Skriv ditt meddelande här.."></textarea>
                </div>
             
                 <button type="submit" class="btn btn-danger">Skicka</button>
             
                    </form>
            </div>
                
        </div>
    </div>
</div>

