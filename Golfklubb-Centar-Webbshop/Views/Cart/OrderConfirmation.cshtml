@model Golfklubb_Centar_Webbshop.Models.Order
@{
    ViewData["Title"] = "Orderbekräftelse";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="display-1">✅</div>
        <h2 class="mt-3">Tack för din beställning, @Model.FullName!</h2>
        <p class="text-muted">Ordernummer: <strong>#@Model.OrderId</strong></p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">Leveransuppgifter</div>
                <div class="card-body">
                    <p class="mb-1">@Model.FullName</p>
                    <p class="mb-1">@Model.Address</p>
                    <p class="mb-1">@Model.PostalCode @Model.City</p>
                    <p class="mb-1">@Model.Country</p>
                    <p class="mb-0">@Model.Phone</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-dark text-white">Beställda produkter</div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produkt</th>
                                <th class="text-center">Antal</th>
                                <th class="text-end">Pris</th>
                                <th class="text-end">Summa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.FkProduct.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("0"):-</td>
                                    <td class="text-end">@item.SubTotal.ToString("0"):-</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold table-secondary">
                                <td colspan="3" class="text-end">Totalt</td>
                                <td class="text-end">@Model.OrderItems.Sum(i => i.SubTotal).ToString("0"):-</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="text-center">
                <a asp-controller="Webshop" asp-action="Index" class="btn btn-success">Fortsätt handla</a>
            </div>
        </div>
    </div>
</div>