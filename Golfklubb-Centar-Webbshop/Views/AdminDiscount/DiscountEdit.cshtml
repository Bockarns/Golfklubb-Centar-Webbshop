@model Golfklubb_Centar_Webbshop.Models.DiscountEditViewModel

@{
    ViewData["Title"] = "Redigera rabatt";
}
<div class="row text-center">
    <h2 class="box-white text-center">@ViewData["Title"]</h2>
</div>
<div class="row">
    <div class="col-md-3">
        <partial name="_AdminNav" />
    </div>
    <div class="col-md-9">
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title mb-4">Redigera rabatt</h4>

                <form method="post" asp-action="DiscountEdit">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Discount.DiscountId" />

                    <div class="mb-3">
                        <label class="form-label">Rabatt (%)</label>
                        <input type="number" asp-for="Discount.Discount1"
                               class="form-control" min="1" max="100" />
                        <span asp-validation-for="Discount.Discount1" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Beskrivning</label>
                        <input type="text" asp-for="Discount.DiscountDescribtion"
                               class="form-control" />
                        <span asp-validation-for="Discount.DiscountDescribtion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Typ</label>
                        <input type="text" asp-for="Discount.DiscountType"
                               class="form-control" />
                        <span asp-validation-for="Discount.DiscountType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Startdatum</label>
                        <input type="date" asp-for="Discount.StartDate"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Slutdatum</label>
                        <input type="date" asp-for="Discount.EndDate"
                               class="form-control" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Spara</button>
                        <a asp-action="DiscountDetails" asp-route-id="@Model.Discount.DiscountId"
                           class="btn btn-outline-secondary">Avbryt</a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Products.Any())
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Produkter med denna rabatt</h5>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produkt</th>
                                <th>Pris</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.ProductPrice kr</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</div>
