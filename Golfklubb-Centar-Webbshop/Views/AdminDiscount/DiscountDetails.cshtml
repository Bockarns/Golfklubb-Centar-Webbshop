@model Golfklubb_Centar_Webbshop.Models.Discount

@{
    ViewData["Title"] = "Rabatt Detaljer | Admin";
}

<div class="row text-center">
    <h2 class="box-white text-center">@ViewData["Title"]</h2>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-3">
            <partial name="_AdminNav" />
        </div>
        <div class="col-lg-9 box-white border rounded">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="d-flex justify-content-between gap-2">
                <h4 class="card-title mb-3">@Model.DiscountDescribtion</h4>
                <div class="d-flex justify-content-end gap-2 align-items-center">
                    <a asp-action="DiscountEdit" asp-route-id="@Model.DiscountId" class="btn btn-warning">Redigera</a>
                    <form method="post" asp-action="DiscountDelete" asp-route-id="@Model.DiscountId"
                          onsubmit="return confirm('Är du säker? Detta går inte att ångra.')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            Radera Rabatt
                        </button>
                    </form>
                    <a asp-action="Discounts" class="btn btn-outline-success">&larr;Tillbaka</a>
                </div>
            </div>
            
            <p><strong>Rabatt ID:</strong> @Model.DiscountId</p>
            <hr />

            <h5>Produkter med denna rabatt</h5>
            <table class="table table-hover box-white-table">
                <thead>
                    <tr>
                        <th>Produkt ID</th>
                        <th>Produkt Namn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>@product.ProductName</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>