@model Golfklubb_Centar_Webbshop.Models.FollowListViewModel

@{
    ViewData["Title"] = "Följer";
}
<div class="row text-center">
    <h2 class="box-white text-center">@ViewData["Title"]</h2>
</div>
<div class="container mt-4 box-white">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>
                    @(Model.IsOwnProfile ? "Användare du följer" : $"{Model.TargetUserName} följer")
                    (@Model.Follows.Count)
                </h4>
                <div class="d-flex gap-2">
                    <a asp-action="Followers" asp-route-id="@Model.TargetUserId"
                       class="btn btn-outline-secondary btn-sm">Följare</a>
                    <a asp-controller="User" asp-action="Profile"
                       asp-route-id="@Model.TargetUserId"
                       class="btn btn-outline-secondary btn-sm">&larr; Tillbaka</a>
                </div>
            </div>

            @if (!Model.Follows.Any())
            {
                <div class="card box-white text-center p-4">
                    <p class="text-muted mb-0">
                        @(Model.IsOwnProfile ? "Du följer inte någon ännu." : $"{Model.TargetUserName} följer inte någon ännu.")
                    </p>
                </div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var follow in Model.Follows)
                    {
                        <div class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-controller="User" asp-action="Profile"
                                       asp-route-id="@follow.FkFollowedUserId"
                                       class="d-flex align-items-center gap-3 text-decoration-none text-dark">
                                    <img src="@(follow.FkFollowedUser.ProfileImageUrl ?? "/images/Profile/avatar.png")"
                                         class="rounded-circle"
                                         style="width: 40px; height: 40px; object-fit: cover;" />
                                    <div>
                                        <p class="mb-0">@follow.FkFollowedUser.UserName</p>
                                        <small class="text-muted">
                                            Följer sedan @follow.FollowDate.ToString("yyyy-MM-dd")
                                        </small>
                                    </div>
                                </a>
                                @if (Model.IsOwnProfile)
                                {
                                    <form method="post" asp-action="ToggleFollow"
                                          asp-route-followedUserId="@follow.FkFollowedUserId">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Avfölja
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>