@model Golfklubb_Centar_Webbshop.Models.Product
@{

    ViewData["Title"] = Model.ProductName;

    decimal finalPrice = Model.FkDiscount.Discount1 > 0

        ? Model.ProductPrice * (1 - (decimal)Model.FkDiscount.Discount1 / 100)

        : Model.ProductPrice;

}

<div class="container py-5 box-white">

    <div class="row g-5">

        <!-- IMAGE -->

        <div class="col-md-7 text-center">

            @if (!string.IsNullOrEmpty(Model.ProductImgPath))

            {

                <img src="@Model.ProductImgPath"
                     alt="@Model.ProductName"
                     class="img-fluid rounded"
                     style=" width:500px; height:500px; object-fit:contain;">

            }

            else

            {

                <img src="https://placehold.co/400x400?text=Bilden+Kommer+Snart"
                     alt="@Model.ProductName"
                     class="img-fluid rounded"
                     style=" width:500px; height:500px; object-fit:contain;">

            }

        </div>


        <div class="col-md-5 py-5">

            <p class="text-muted small mb-1">@Model.FkCategory.CategoryName</p>

            <h2 class="fw-bold mb-3">@Model.ProductName</h2>

            <p class="text-muted mb-4">@Model.ProductDescribtion</p>

            @if (Model.FkDiscount.Discount1 > 0)

            {

                <p class="text-muted small mb-0">

                    Ord. pris <s>@Model.ProductPrice.ToString("C"):-</s>

                </p>

                <span class="badge bg-warning text-dark mb-2">

                    SPARA @Model.FkDiscount.Discount1@Model.FkDiscount.DiscountType

                </span>

            }

            <p class="fs-3 fw-bold mb-4">

                <span id="totalPrice">@finalPrice.ToString("C"):-</span>

            </p>

            <!-- Pris ändrig JS är gjord med claude, går sedan att byta om man vill --> 

            <div class="d-flex align-items-center gap-3 mb-4">

                <label class="fw-semibold">Antal:</label>

                <div class="input-group" style="width:140px;">

                    <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">−</button>

                    <input type="number" id="quantity" class="form-control text-center" value="1" min="1" max="99" oninput="updatePrice()">

                    <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">+</button>

                </div>

            </div>

            <p class="text-muted small mb-4">

                Pris per styck: <strong>@finalPrice.ToString("C"):-</strong>

            </p>

            <div class="d-flex gap-2">

                <button class="btn btn-success px-4">Lägg i varukorg</button>

                <a asp-action="Index" class="btn btn-outline-secondary">← Tillbaka</a>

            </div>

        </div>

    </div>

</div>

<script>

    const pricePerUnit = @finalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)

    function updatePrice() {

        const qty = parseInt(document.getElementById('quantity').value) || 1;

        const total = (pricePerUnit * qty).toFixed(0);

        document.getElementById('totalPrice').textContent = total + ':-';

    }

    function changeQty(amount) {

        const input = document.getElementById('quantity');

        const current = parseInt(input.value) || 1;

        const next = Math.max(1, Math.min(99, current + amount));

        input.value = next;

        updatePrice();

    }

</script>