@{
    ViewData["Title"] = "Admin Panel";
}

<div class="col-md-9 text-center">
    <h2>@ViewData["Title"]</h2>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-3">
            <partial name="_AdminNav" />
        </div>
        <div class="col-md-9 box-white">
            <h2>Välkommen till Admin Panel</h2>
            <p>Här kan du redigera och ta bort användare.</p>
            <p>Lägga till, redigera eller ta bort Kategorier, Produkter och Rabatter.</p>
            <p>Övervaka forumet.</p>
            <p>Och även hantera inkommande beställningar från kunder.</p>
        </div>
    </div>
</div>