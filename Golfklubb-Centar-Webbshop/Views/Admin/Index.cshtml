@{
    ViewData["Title"] = "Admin Panel";
}

<div class="row text-center">
    <h2 class="box-white text-center">@ViewData["Title"]</h2>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-3">
            <partial name="_AdminNav" />
        </div>
        <div class="col-md-9 box-white">
            <h2>Välkommen till Admin Panel</h2>
            <p>Här kan du redigera och ta bort användare.</p>
            <p>Lägga till, redigera eller ta bort Kategorier, Produkter och Rabatter.</p>
            <p>Övervaka forumet.</p>
            <p>Och även hantera inkommande beställningar från kunder.</p>

            <p>Skulle vilja ha 4+ counters här, 1 för ordrar(1 för varje status kanske?), 1 för nya reviews, 1 för nya forum trådar och 1 för nya kommentarer</p>
        </div>
    </div>
</div>