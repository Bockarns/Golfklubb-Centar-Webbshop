@model Golfklubb_Centar_Webbshop.Areas.Identity.Data.ApplicationUser

@{
    ViewData["Title"] = "Användardetaljer";
}
<div class="col-md-9 text-center">
    <h2>Användare info</h2>
</div>
<div class="row">
    <div class="col-md-3">
        <partial name="_AdminNav" />
    </div>
    <div class="col-md-9">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card mb-4 box-white">
            @*Här vill vi att den visar användarbild*@
            <div class="card-body">
                
                <div class="d-flex justify-content-between gap-2">
                    <h4 class="card-title mb-3">@Model.UserName</h4>
                <div class="d-flex justify-content-end gap-2">
                        <a asp-action="UserEdit" asp-route-id="@Model.Id"
                   class="btn btn-success">Redigera</a>
                <a asp-action="Users" class="btn btn-outline-success">Tillbaka</a>
                    </div>
                </div>
                <table class="table table-borderless table-hover box-white-table">
                    <tr>
                        <td class="text-muted">Email</td>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Användarnamn</td>
                        <td>@Model.UserName</td>
                    </tr>
                    @*Här vill vi ha även namn*@
                    <tr>
                        <td class="text-muted">Roll</td>
                        <td>
                            @foreach (var role in ViewBag.Roles)
                            {
                                <span class="badge bg-secondary">@role</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Email bekräftad</td>
                        <td>@(Model.EmailConfirmed ? "Ja" : "Nej")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Telefon</td>
                        <td>@(Model.PhoneNumber ?? "–")</td>
                    </tr>
                </table>
                <div class="d-flex gap-2">
                    <a asp-action="UserOrderHistory" asp-route-id="@Model.Id"
                       class="btn btn-outline-success w-50">Orderhistorik</a>
                    <a asp-action="UserForumHistory" asp-route-id="@Model.Id"
                       class="btn btn-outline-success w-50">Forumhistorik</a>
                </div>
                
            </div>
        </div>

        

    </div>
</div>