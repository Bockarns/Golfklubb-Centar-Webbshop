@model IEnumerable<Golfklubb_Centar_Webbshop.Models.Product>
@{
    ViewData["Title"] = "Produkter | Admin";
}
<div class="col-md-9 text-center">
    <h2>@ViewData["Title"]</h2>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-3">
            <partial name="_AdminNav" />
        </div>
        <div class="col-md-9 box-white border rounded">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Alla Produkter</h4>
                <div class="d-flex justify-content-end gap-2 align-items-center">
                    <a asp-action="ProductCreate" class="btn btn-primary">&plus; Ny Produkt</a>
                    <a asp-action="Webshop" class="btn btn-outline-success">&larr; Tillbaka</a>
                </div>
            </div>
            <table class="table table-hover box-white-table ">
                <thead>
                    <tr>
                        <th>Produkt ID</th>
                        <th>Produkt Namn</th>
                        <th>Pris</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>@product.ProductName</td>
                            <td>@product.ProductPrice</td>
                            <td><a asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-info">Info</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
