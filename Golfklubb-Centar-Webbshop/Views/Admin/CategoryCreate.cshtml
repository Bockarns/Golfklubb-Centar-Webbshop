@model Golfklubb_Centar_Webbshop.Models.Category

@{
    ViewData["Title"] = "Ny Kategori | Admin";
}

<div class="col-md-9 text-center">
    <h2>Ny Kategori</h2>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-3">
            <partial name="_AdminNav" />
        </div>
        <div class="col-md-9 box-white border rounded p-3">

            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label">Kategori Namn</label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">Spara</button>
                <a asp-action="Categories" class="btn btn-secondary">Avbryt</a>
            </form>

        </div>
    </div>
</div>