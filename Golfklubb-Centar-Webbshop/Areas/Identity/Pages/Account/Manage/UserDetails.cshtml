@page
@model Golfklubb_Centar_Webbshop.Areas.Identity.Pages.Account.Manage.UserDetailsModel
@{
    ViewData["Title"] = "Redigera användaruppgifter";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="col-md-9 box-white border rounded p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Redigera användaruppgifter</h4>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <!-- PROFILBILD -->
        <div class="mb-4 text-center">
            <label class="form-label fw-bold">Profilbild</label>

            <div class="mb-2">
                @if (!string.IsNullOrEmpty(Model.Input?.ExistingProfileImage))
                {
                    <img src="@Model.Input.ExistingProfileImage"
                         alt="Profilbild"
                         style="width:120px; height:120px; object-fit:cover; border-radius:50%; border:1px solid #ccc;" />
                }
                else
                {
                    <p class="text-muted">Ingen profilbild uppladdad</p>
                }
            </div>

            <input asp-for="Input.ProfileImage" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="Input.ProfileImage" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.FirstName" class="form-label">Fullständigt namn</label>
            <input asp-for="Input.FirstName" class="form-control" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.UserName" class="form-label">Användarnamn</label>
            <input asp-for="Input.UserName" class="form-control" />
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.EmailAdress" class="form-label">E-Post Adress</label>
            <input asp-for="Input.EmailAdress" class="form-control" />
            <span asp-validation-for="Input.EmailAdress" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label">Telefonnummer</label>
            <input asp-for="Input.PhoneNumber" class="form-control" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Spara ändringar</button>
            <a asp-page="./Index" class="btn btn-secondary">Tillbaka</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}