@page
@model Golfklubb_Centar_Webbshop.Areas.Identity.Pages.Account.Manage.OrderHistoryModel
@{
    ViewData["Title"] = "Order Historik";
    ViewData["ActivePage"] = ManageNavPages.OrderHistory;
}

<h3 class="mb-4">Mina Ordrar</h3>

<div class="container box-white p-3">

    <table class="table table-striped table-hover align-middle">
        <thead class="table-primary">
            <tr>
                <th>Order ID</th>
                <th>Datum</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(order.OrderStatus == "Levererad" ? "bg-success" :
                                                                                      order.OrderStatus == "Avbruten" ? "bg-danger" :
                                                                                      order.OrderStatus == "Skickad" ? "bg-info" :
                                                                                      order.OrderStatus == "Packas" ? "bg-warning" :
                                                                                      "bg-secondary")">
                        @(order.OrderStatus ?? "Ny Order")
                    </span>
                    </td>

                    <td>
                        <a asp-page="./Kvitto"
                           asp-route-id="@order.OrderId"
                           class="btn btn-sm btn-outline-info">
                            Visa
                        </a>
                    </td>
                </tr>
                        }
        </tbody>
    </table>

</div>