@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Skicka e-postbekräftelsen igen";
}

<h1 class="container box-white text-center">@ViewData["Title"]</h1>
<hr/>
<div class="row d-flex justify-content-center">
    <div class=" box-white col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Ange din e-postadress</label>
                <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Skicka igen</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
