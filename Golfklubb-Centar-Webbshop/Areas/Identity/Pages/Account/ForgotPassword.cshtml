@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Glömt lösenordet?";
}

<h1 class="container box-white text-center">@ViewData["Title"]</h1>
<hr/>
<div class="row d-flex justify-content-center">
    <div class="col-md-4 box-white">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Ange din e-postadress</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />                
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Återställ lösenord</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
